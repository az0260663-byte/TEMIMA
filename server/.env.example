# הגדרות שרת הסטודיו של תמימה.
# מעתיקים את הקובץ הזה לקובץ בשם .env באותה תיקייה, וממלאים. הקובץ .env לא עולה לגיטהאב ולא מוגש לדפדפן.

# מזהה הלקוח (אותו מזהה שב-config.js)
GOOGLE_CLIENT_ID=329242531588-mbv6kie5i8l05p83o4dcdijgcqs0p4tv.apps.googleusercontent.com

# הסוד של מזהה הלקוח. מ-Google Cloud Console: Google Auth Platform > Clients > Tamima Studio Web > Add secret
# זה סוד אמיתי: לא לשתף, לא לשלוח בצ'אט, ולא להעלות לשום מקום.
GOOGLE_CLIENT_SECRET=

# חשבון הסטודיו. רק הוא יוכל להתחבר. אם ריק, החשבון הראשון שמתחבר הופך לחשבון הסטודיו.
OWNER_EMAIL=

# בשרת אמיתי עם https: 1 (עוגייה מאובטחת וכותרת HSTS). במחשב המקומי: 0
COOKIE_SECURE=0

# פורט השרת
PORT=8123

# איפה נשמרים נתוני הסטודיו: file = קובץ מקומי בתיקייה server/data (לפיתוח), supabase = מסד הנתונים ב-Supabase
STORE=file

# רק כש-STORE=supabase. מ-Supabase: Project Settings > API
# הכתובת של הפרויקט, למשל https://abcd1234.supabase.co
SUPABASE_URL=
# המפתח הסודי (service_role). זה סוד אמיתי: לא לשתף, לא לשלוח בצ'אט, ולא להעלות לשום מקום.
SUPABASE_SERVICE_KEY=

# מפתח ההצפנה של השרת (לחיבור לגוגל ולגיבויים). במחשב המקומי נוצר לבד בתיקייה server/data.
# בשרת אמיתי (Render) חובה להגדיר אותו כאן, אחרת אחרי כל הפעלה מחדש הגיבויים לא ייפתחו.
# יצירה: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TAMIMA_KEY=

# סליקה אמיתית במורנינג (לבדיקה מקצה לקצה). ריק = התשלום בדמו מדומה.
# מ-Morning: הגדרות > כלים למפתחים > API. זה סוד: לא לשלוח בצ'אט.
MORNING_CLIENT_ID=
MORNING_CLIENT_SECRET=
# production = החשבון האמיתי (מחירי בדיקה של שקלים בודדים). sandbox = סביבת הבדיקה של מורנינג, עם מפתחות נפרדים
MORNING_ENV=production
# קישור תשלום קבוע (אופציונלי). אם מוגדר, הלקוחות משלמים בו, והשרת מזהה את התשלום לפי סכום, מייל ושעה.
# ריק = לכל הזמנה נוצר דף תשלום משלה (מומלץ: הסכום והפרטים כבר ממולאים, והזיהוי לפי מזהה ההזמנה)
MORNING_FIXED_LINK=
